# Vamos a ordenar la configuración de Nginx en tu dominio para que convivan la web normal y el WebSocket sin pisarse.
# El Gallo "pisa" a la Gallina

# 1. Configuración obligatoria para la RAÍZ de Chatwoot (Panel de administración)
location / {
    # 1. Aseguramos que pasamos la URL completa con todos sus parámetros (?api_access_token=...)
    proxy_pass http://127.0.0.1:3000$is_args$args;

    # 2. Permitimos explícitamente los headers con guiones bajos por si acaso
    proxy_pass_request_headers on;
    
    # 3. Mapeos de seguridad estándar para proxies de Rails
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_set_header X-Forwarded-Ssl on;
    proxy_set_header X-Forwarded-Port $server_port;
}

# 2. Configuración obligatoria para el TIEMPO REAL (WebSockets)
location /cable {
	proxy_pass http://127.0.0.1:3000;
	proxy_http_version 1.1;
	proxy_set_header Upgrade $http_upgrade;
	proxy_set_header Connection "upgrade";

	proxy_set_header Host $http_host;
	proxy_set_header X-Real-IP $remote_addr;
	proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
	proxy_set_header X-Forwarded-Proto $scheme;

	proxy_read_timeout 86400;
}
